      string currency_code
      date target_date
    }
    GOAL_CONTRIBUTIONS {
      uuid BINARY(16) id PK
      uuid BINARY(16) goal_id FK
      string contribution_type
      DECIMAL(19,4) amount
      uuid BINARY(16) fund_reservation_id FK
    }
    FUND_RESERVATIONS {
      uuid BINARY(16) id PK
      uuid BINARY(16) account_id FK
      DECIMAL(19,4) amount
      string currency_code
      string reservation_type
      string status
    }
```

## 5. Reliability and history

```mermaid
erDiagram
    USERS ||--o{ IDEMPOTENCY_RECORDS : submits
    USERS ||--o{ AUDIT_EVENTS : acts
    CURRENCIES ||--o{ FX_RATES : base_currency

    IDEMPOTENCY_RECORDS {
      uuid BINARY(16) id PK
      uuid BINARY(16) user_id FK
      string operation_scope
      string idempotency_key
      string request_hash
    }
    AUDIT_EVENTS {
      uuid BINARY(16) id PK
      uuid BINARY(16) actor_user_id FK
      string action
      string resource_type
      uuid BINARY(16) resource_id
      datetime occurred_at
    }
    FX_RATES {
      uuid BINARY(16) id PK
      string base_currency_code FK
      string quote_currency_code FK
      rate (decimal precision unspecified)
      string rate_source
      datetime rate_timestamp
    }
```
