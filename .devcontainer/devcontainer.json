{
  "name": "Spendly Codespaces",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/spendly-budget-tracker",
  "remoteUser": "vscode",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Spendly frontend",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "Spendly API",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.3": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}
